{
  "enabledMcpjsonServers": ["supabase"],
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(./scripts/pre-commit-checks.sh)",
      "Bash(./scripts/check-deploy-manifest.sh:*)",
      "Bash(./scripts/next-p-number.sh)",
      "Bash(git check-ignore:*)",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "Bash(./scripts/git-ops.sh:*)",
      "Bash(./scripts/ship-gates.sh:*)",
      "Bash(./scripts/audit-privacy.sh:*)",
      "Bash(./scripts/typecheck-gate.sh:*)",
      "Bash(./scripts/test-typecheck-gate.sh:*)",
      "Bash(./scripts/next-a-number.sh)",
      "Bash(./scripts/next-t-number.sh)",
      "Bash(./scripts/mcp-validate.sh:*)",
      "Bash(./scripts/validate-features.sh:*)",
      "Bash(./scripts/check-duplicate-p-numbers.sh:*)",
      "Bash(./scripts/check-nav-route-consistency.sh:*)",
      "Bash(./scripts/check-worktree-env.sh:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx tsc -p tsconfig.app.json --noEmit:*)",
      "Bash(npx vitest run:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(python3 scripts/fix-frontmatter.py:*)",
      "Bash(python3 scripts/fix-skill-frontmatter.py:*)",
      "Bash(gcloud logging read:*)",
      "Bash(gcloud run services describe:*)",
      "Bash(gcloud run services list:*)",
      "Bash(gcloud scheduler jobs list:*)",
      "Bash(sips -g:*)",
      "mcp__chrome-devtools__take_screenshot",
      "mcp__chrome-devtools__resize_page",
      "mcp__claude-in-chrome__browser_batch",
      "mcp__claude-in-chrome__computer",
      "mcp__claude-in-chrome__navigate",
      "mcp__claude-in-chrome__javascript_tool",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__tabs_create_mcp",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__read_page",
      "mcp__chrome-devtools__navigate_page",
      "mcp__chrome-devtools__new_page"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/claude-md-gate-pre.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-screenshot-before-reedit.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-pw-tail-pipe.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-banned-git.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-before-stop.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/route-brief.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Context was just compacted. Reorient before continuing: (1) git status to see modified files, (2) grep -r \"status: in-progress\" features/ to find active work, (3) re-read the active spec file if working from a P-number, (4) re-read the last file you were editing to verify changes are there.'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design-system-check.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-after-edit.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
