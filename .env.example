# === Required (dev + prod) — copy to .env.local ===

VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key

# === Prod migrations (copy to .env.prod, run: ./scripts/migrate.sh --env prod) ===

# Prod DB connection URL
# Format: postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROD_PROJECT_REF:YOUR_DB_PASSWORD_HERE@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase Personal Access Token — used by migrate.sh Management API fallback
# Get from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_YOUR_PERSONAL_ACCESS_TOKEN

# === Optional ===

# Unsplash API key for event auto-banner (must also be set in Vercel dashboard)
# VITE_UNSPLASH_ACCESS_KEY=your-unsplash-key

# Feature Flags
# VITE_ALLOW_DUPLICATE_NAMES=true

# Sentry (required for prod error tracking + source maps)
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=clarity-pledge
# SENTRY_AUTH_TOKEN=sntrys_xxxxx
