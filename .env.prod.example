# .env.prod — Production Supabase credentials
# Copy this file to .env.prod and fill in your prod project values.
# .env.prod is gitignored — never commit it.
#
# Usage: ./scripts/migrate.sh --env prod

# Prod Supabase project URL (used to extract project ref)
VITE_SUPABASE_URL=https://YOUR_PROD_PROJECT_REF.supabase.co

# Prod DB connection URL (password extracted by migrate.sh)
# Format: postgresql://postgres.PROJECT_REF:xf2FWMgpkr75K5K3@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROD_PROJECT_REF:xf2FWMgpkr75K5K3@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase Personal Access Token — used by migrate.sh Management API fallback
# Get from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_YOUR_PERSONAL_ACCESS_TOKEN
