legacy-peer-deps=true
# P1563: release-age cooldown, in DAYS (npm >= 11.x; older npm ignores the key).
# Covers dependency resolution (npm install / update / exec), not `npm ci` from
# an existing lock. Urgent security bump: add a line `min-release-age-exclude[]=<pkg>`
# here, or pass --min-release-age-exclude=<pkg> for one command.
min-release-age=7
