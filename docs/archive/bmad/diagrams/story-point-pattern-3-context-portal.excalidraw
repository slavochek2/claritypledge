    },
    {
      "id": "callout-title",
      "type": "text",
      "x": 950,
      "y": 185,
      "width": 260,
      "height": 24,
      "text": "Pattern 3: Context Portal",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#7c3aed",
      "backgroundColor": "transparent",
      "fillStyle": "solid"
    },
    {
      "id": "callout-pros",
      "type": "text",
      "x": 950,
      "y": 220,
      "width": 260,
      "height": 100,
      "text": "PROS:\n• Scales to 100+ stories (AI summarizes)\n• Shows patterns, not just individuals\n• Unique to your platform (differentiator)\n• Respects user attention (summary first)\n• Can still drill into individual stories",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#166534",
      "backgroundColor": "transparent",
      "fillStyle": "solid"
    },
    {
      "id": "callout-cons",
      "type": "text",
      "x": 950,
      "y": 330,
      "width": 260,
      "height": 80,
      "text": "CONS:\n• AI summary may miss nuance\n• Individual voices feel secondary\n• Requires good AI summarization\n• More complex to build\n• May feel \"impersonal\"",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#991b1b",
      "backgroundColor": "transparent",
      "fillStyle": "solid"
    },

    {
      "id": "unique-box",
      "type": "rectangle",
      "x": 930,
      "y": 450,
      "width": 300,
      "height": 120,
      "strokeColor": "#a855f7",
      "backgroundColor": "#faf5ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": { "type": 3, "value": 12 }
    },
    {
      "id": "unique-title",
      "type": "text",
      "x": 950,
      "y": 465,
      "width": 260,
      "height": 20,
      "text": "UNIQUE VALUE:",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#7c3aed",
      "backgroundColor": "transparent",
      "fillStyle": "solid"
    },
    {
      "id": "unique-text",
      "type": "text",
      "x": 950,
      "y": 490,
      "width": 260,
      "height": 70,
      "text": "This is the only pattern that answers:\n\"What do people who agree/disagree\nhave in common?\"\n\nIt's insight, not just data.",
      "fontSize": 11,
