    {
      "type": "text",
      "version": 1,
      "id": "decision-1-title",
      "x": 500,
      "y": 1040,
      "width": 340,
      "height": 20,
      "text": "1. Point Cards Have NO Icon",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#92400e",
      "backgroundColor": "transparent"
    },
    {
      "type": "text",
      "version": 1,
      "id": "decision-1-text",
      "x": 500,
      "y": 1065,
      "width": 340,
      "height": 60,
      "text": "Points are GLOBAL/OWNERLESS - no person posted\nthem, they emerge from the system. No avatar circle,\nno \"P\" icon. Yellow card + border is sufficient visual\ndistinction. Removes \"who posted this?\" confusion.",
      "fontSize": 12,
      "fontFamily": 1,
      "strokeColor": "#374151",
      "backgroundColor": "transparent"
    },

    {
      "type": "rectangle",
      "version": 1,
      "id": "decision-box-2",
      "x": 480,
      "y": 1155,
      "width": 380,
      "height": 100,
      "strokeColor": "#3b82f6",
      "backgroundColor": "#eff6ff",
      "strokeWidth": 2,
      "roundness": { "type": 3, "value": 12 }
    },
    {
      "type": "text",
      "version": 1,
      "id": "decision-2-title",
      "x": 500,
      "y": 1170,
      "width": 340,
      "height": 20,
      "text": "2. Verification Request = No Chat Required",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#1e40af",
      "backgroundColor": "transparent"
    },
    {
      "type": "text",
      "version": 1,
      "id": "decision-2-text",
      "x": 500,
      "y": 1195,
      "width": 340,
      "height": 50,
      "text": "Anyone can request verification from any public Story.\nFlow: Tap \"Verify\" → Notification → [Accept/Decline]\n→ /live session. The /live session IS the conversation.",
      "fontSize": 12,
      "fontFamily": 1,
      "strokeColor": "#374151",
      "backgroundColor": "transparent"
    },

    {
      "type": "rectangle",
      "version": 1,
      "id": "decision-box-3",
      "x": 480,
      "y": 1275,
      "width": 380,
      "height": 110,
      "strokeColor": "#22c55e",
      "backgroundColor": "#dcfce7",
      "strokeWidth": 2,
      "roundness": { "type": 3, "value": 12 }
    },
    {
      "type": "text",
      "version": 1,
      "id": "decision-3-title",
      "x": 500,
      "y": 1290,
      "width": 340,
      "height": 20,
      "text": "3. Linked Points Show Both Positions",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#166534",
      "backgroundColor": "transparent"
    },
    {
      "type": "text",
      "version": 1,
      "id": "decision-3-text",
      "x": 500,
      "y": 1315,
      "width": 340,
      "height": 60,
      "text": "On Story Detail, linked Points show BOTH the\nauthor's position AND your position:\n\"Sarah: Agrees | You: Agree\"\nHelps understand alignment/disagreement.",
      "fontSize": 12,
      "fontFamily": 1,
      "strokeColor": "#374151",
      "backgroundColor": "transparent"
    },

    {
      "type": "rectangle",
      "version": 1,
      "id": "decision-box-4",
      "x": 480,
      "y": 1405,
      "width": 380,
      "height": 100,
      "strokeColor": "#6b7280",
      "backgroundColor": "#f3f4f6",
      "strokeWidth": 2,
      "roundness": { "type": 3, "value": 12 }
    },
    {
      "type": "text",
      "version": 1,
      "id": "decision-4-title",
      "x": 500,
      "y": 1420,
      "width": 340,
      "height": 20,
      "text": "4. Cross-Position Discovery = Filter",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#374151",
      "backgroundColor": "transparent"
    },
    {
      "type": "text",
      "version": 1,
      "id": "decision-4-text",
      "x": 500,
      "y": 1445,
      "width": 340,
      "height": 50,
      "text": "Not a separate journey - just use filter tabs in Point\nDetail. Tap \"Disagree\" → Same view, filtered to\ndisagreeing Stories. The filter IS the discovery.",
      "fontSize": 12,
      "fontFamily": 1,
      "strokeColor": "#374151",
      "backgroundColor": "transparent"
    },

    {
      "type": "text",
